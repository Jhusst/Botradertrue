# App
APP_ENV=development
APP_MODE=PAPER
DEBUG=true

# Database (SQLite por defecto; usa PostgreSQL con docker compose)
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
DATABASE_URL_SYNC=sqlite:///./trading_bot.db
# DATABASE_URL=postgresql+asyncpg://trading:trading_dev@localhost:5432/trading_bot
# DATABASE_URL_SYNC=postgresql://trading:trading_dev@localhost:5432/trading_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Trading
DEFAULT_ACCOUNT_BALANCE=60.0
DEFAULT_RISK_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2.0
MAX_WEEKLY_LOSS_PERCENT=5.0
MAX_CONSECUTIVE_LOSSES=2
MIN_RISK_REWARD_RATIO=2.0

# Exchange — precios públicos sin keys; cuenta/órdenes con API key (sin permiso de retiro)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BROKER_ENABLED=false
AUTO_EXECUTE_ON_ENTER=false
SYNC_BALANCE_FROM_BROKER=false

# Modo autónomo (bot opera solo — requiere Ollama + Binance para ejecución real)
AUTONOMOUS_TRADING_ENABLED=false
AI_GATE_AUTO_TRADE=true
AI_REQUIRED_FOR_AUTO_TRADE=false
AI_AUTO_MIN_VERDICT=CONFIRM
MIN_BALANCE_FOR_AUTONOMOUS=1.0
COMPOUND_BALANCE_ON_CLOSE=true

# Telegram (alertas en tiempo real — imprescindible para no perder entradas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoreo automático
MONITOR_ENABLED=true
WATCH_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,AVAX/USDT,ADA/USDT,HYPE/USDT
SCAN_INTERVAL_SECONDS=300
PRICE_CHECK_INTERVAL_SECONDS=30
ENTRY_PROXIMITY_PERCENT=0.5
SIGNAL_TTL_HOURS=4
AUTO_PAPER_TRADE=true
MONITOR_USE_LIVE_DATA=true
# Perfiles que escanea el monitor (conservative,aggressive o solo uno)
ACTIVE_PROFILE_TYPES=aggressive

# Live mode (BLOQUEADO por defecto)
LIVE_MODE_ENABLED=false

# Ollama (opcional — complementa análisis, nunca decide sola)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava
AI_ENABLED=false
AI_MAX_CONFIDENCE_ADJUSTMENT=10.0
