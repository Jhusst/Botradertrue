# App
APP_ENV=development
APP_MODE=PAPER
DEBUG=true

# Database (SQLite por defecto; usa PostgreSQL con docker compose)
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
DATABASE_URL_SYNC=sqlite:///./trading_bot.db
# DATABASE_URL=postgresql+asyncpg://trading:trading_dev@localhost:5432/trading_bot
# DATABASE_URL_SYNC=postgresql://trading:trading_dev@localhost:5432/trading_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Trading
DEFAULT_ACCOUNT_BALANCE=60.0
DEFAULT_RISK_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=2.0
MAX_WEEKLY_LOSS_PERCENT=5.0
MAX_CONSECUTIVE_LOSSES=2
MIN_RISK_REWARD_RATIO=2.0

# Exchange — precios públicos sin keys; cuenta/órdenes con API key (sin permiso de retiro)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BROKER_ENABLED=false
AUTO_EXECUTE_ON_ENTER=false
SYNC_BALANCE_FROM_BROKER=false

# Modo autónomo (bot opera solo — requiere Ollama + Binance para ejecución real)
AUTONOMOUS_TRADING_ENABLED=false
AI_GATE_AUTO_TRADE=true
AI_REQUIRED_FOR_AUTO_TRADE=false
AI_AUTO_MIN_VERDICT=CONFIRM
MIN_BALANCE_FOR_AUTONOMOUS=1.0
COMPOUND_BALANCE_ON_CLOSE=true

# Telegram (alertas en tiempo real — imprescindible para no perder entradas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoreo automático
MONITOR_ENABLED=true
WATCH_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,AVAX/USDT,ADA/USDT,HYPE/USDT
SCAN_INTERVAL_SECONDS=300
PRICE_CHECK_INTERVAL_SECONDS=30
ENTRY_PROXIMITY_PERCENT=0.5
SIGNAL_TTL_HOURS=4
AUTO_PAPER_TRADE=true
MONITOR_USE_LIVE_DATA=true
# Perfiles que escanea el monitor (conservative,aggressive o solo uno)
ACTIVE_PROFILE_TYPES=aggressive

# Live mode (BLOQUEADO por defecto)
LIVE_MODE_ENABLED=false

# Ollama (opcional — complementa análisis, nunca decide sola)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llava
AI_ENABLED=false
AI_MAX_CONFIDENCE_ADJUSTMENT=10.0

# Idempotencia / reconciliación contra Binance
CLIENT_ORDER_PREFIX=tbot
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_ON_STARTUP=true
ADOPT_UNKNOWN_POSITIONS=false

# Protección garantizada (SL obligatorio)
SL_PLACEMENT_MAX_RETRIES=4
SL_PLACEMENT_BACKOFF_BASE_SECONDS=1.0
FLATTEN_ON_PROTECTION_FAILURE=true

# Resiliencia de red
EXCHANGE_RETRY_MAX_ATTEMPTS=4
EXCHANGE_RETRY_BACKOFF_BASE=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=120
MONITOR_CYCLE_TIMEOUT_SECONDS=120
WATCHDOG_INTERVAL_SECONDS=60
WATCHDOG_STALE_AFTER_SECONDS=180

# Kill-switch / límite de pérdida ABSOLUTO en USDT (cuenta chica)
MAX_TOTAL_LOSS_USDT=50.0
MIN_EQUITY_USDT=0.0
INITIAL_EQUITY_USDT=500.0
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_COMMAND_POLL_SECONDS=5

# Logging / operación 24/7
LOG_FILE_PATH=./logs/trading_bot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
STARTUP_ALERT_ENABLED=true

# Datos históricos / alt-data legal (funding, OI, long/short ratio)
DATA_DIR=./data
HISTORY_BACKFILL_DAYS=730
DERIVATIVES_ENABLED=true

# Régimen de mercado (tendencia/rango/alta volatilidad)
REGIME_DETECTION_ENABLED=true

# Kelly fraccionado (solo REDUCE el riesgo; requiere >=20 trades de historial)
KELLY_ENABLED=false
KELLY_FRACTION=0.25
KELLY_LOOKBACK_TRADES=50
KELLY_MIN_TRADES=20
KELLY_CAP_RISK_PERCENT=0.5
KELLY_FLOOR_RISK_PERCENT=0.1

# Filtro ML meta-labeling (sin modelo desplegado = passthrough)
ML_FILTER_ENABLED=false
ML_FILTER_MODE=advise
ML_MIN_SUCCESS_PROBABILITY=0.55
ML_MODELS_DIR=./models
ML_RETRAIN_DAYS=7
