[Unit]
Description=Trading Bot - API FastAPI
After=network-online.target trading-bot-ollama.service
Wants=network-online.target trading-bot-ollama.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONPATH=@PROJECT_ROOT@/src
Environment=DATABASE_URL=sqlite+aiosqlite:///@PROJECT_ROOT@/trading_bot.db
ExecStart=@PROJECT_ROOT@/.venv/bin/uvicorn trading_bot.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
